DATABASE_URL=postgresql://user:pass@localhost:5432/bhoomisetu
REDIS_URL=redis://localhost:6379/0
FIREBASE_PROJECT_ID=bhoomisetu-ai
FIREBASE_SERVICE_ACCOUNT_JSON=
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
FRONTEND_URL=http://localhost:3000
# OCR engine options:
#   mock      — deterministic fixture data, no GPU/model needed (default)
#   paddleocr — PaddleOCR-VL-1.6 (pip install "paddleocr[doc-parser]>=3.6.0")
#               falls back to classic PaddleOCR 2.x if VL not installed
#   tesseract — Tesseract OCR fallback, English+Hindi+Bengali
#               (pip install pytesseract + install Tesseract binary)
#   trocr     — Microsoft TrOCR for handwritten text (pip install transformers torch)
#   composite — PaddleOCR (printed) + TrOCR (handwritten) combined
OCR_ENGINE=mock
CONFIDENCE_THRESHOLD=0.85
GIS_AREA_TOLERANCE_PERCENT=10
